{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/docs/reference",
      "!!**/.wrangler",
      "!!**/.turbo",
      "!**/routeTree.gen.ts",
      "!**/worker-configuration.d.ts",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!docs/fixtures",
      "!pnpm-lock.yaml"
    ]
  },
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
