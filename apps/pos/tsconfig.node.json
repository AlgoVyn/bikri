{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": ".tsbuild/types-node",
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuild/types-node/tsconfig.tsbuildinfo",
    "types": ["node"],
    "lib": ["ES2024"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "pwa.config.ts",
    "scripts/**/*.ts"
  ],
  "references": [{ "path": "../../packages/core" }]
}
