{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bikri",
  // Cloudflare account "operator account" (not a secret)
  "account_id": "e71e6ef868a1404888d1751c815913b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../pos/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/bikri/api/*"]
  },
  // Path routes on the existing algovyn.com zone (NOT a custom domain: that would take over the whole hostname)
  "routes": [
    { "pattern": "algovyn.com/bikri", "zone_name": "algovyn.com" },
    { "pattern": "algovyn.com/bikri/*", "zone_name": "algovyn.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bikri",
      // Created 27 Oct 2026 (location hint APAC). `wrangler dev` still uses a local D1.
      "database_id": "ce6212af-73a8-4955-b271-a54da06d07ff",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "bikri-files" }, // till file API: only keys under products/ and shop/
    { "binding": "BACKUPS", "bucket_name": "bikri-backups" } // admin API only
  ],
  "vars": {
    "APP_VERSION": "0.1.0",
    "SCHEMA_VERSION": "1",
    "MIN_CLIENT_SCHEMA": "1",
    "MAINTENANCE": "0",
    "ACCESS_TEAM_DOMAIN": "odd-rain-0287.cloudflareaccess.com", // Zero Trust team domain (Access app "Bikri admin")
    "BASE_PATH": "/bikri",
    "ALLOWED_ORIGINS": "https://algovyn.com",
    "SHOP_TIMEZONE": "Asia/Karachi",
    // "test" only in Worker tests and E2E (`--var ENV:test`); enables ACCESS_TEST_EMAIL and the fake email outbox.
    // The Worker refuses requests if ENV=test while ALLOWED_ORIGINS contains https://algovyn.com (10 §5).
    "ENV": "production"
  },
  // Owner email sign-in (T-028, 05 §3.2). Config only: nothing is created by deploying this binding, but before the
  // first deploy Adnan must (1) enable Email Routing on algovyn.com (already on) and (2) add each shop owner's address
  // under Email Service -> Email Routing -> Destination addresses so Cloudflare sends them a verification link.
  // Sending to unverified addresses fails and the API answers 503 EMAIL_UNAVAILABLE.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["bikri@algovyn.com"] }
  ],
  // Workers Rate Limiting binding (approximate, per location); namespace_id is our own label, not a dashboard resource.
  "ratelimits": [
    {
      "name": "OWNER_SIGNIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": { "crons": ["30 21 * * *"] },
  "observability": { "enabled": true }
  // secrets (wrangler secret put): ACCESS_AUD, OWNER_EMAILS (= "operator@example.com"),
  // OWNER_CODE_KEY and OWNER_SESSION_KEY (32 random bytes each, e.g. `openssl rand -base64 32`). Typed in src/secrets.d.ts.
}
