{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bikri",
  // Cloudflare account "operator account" (not a secret)
  "account_id": "e71e6ef868a1404888d1751c815913b5",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../pos/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/bikri/api/*"]
  },
  // Path routes on the existing algovyn.com zone (NOT a custom domain: that would take over the whole hostname)
  "routes": [
    { "pattern": "algovyn.com/bikri", "zone_name": "algovyn.com" },
    { "pattern": "algovyn.com/bikri/*", "zone_name": "algovyn.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bikri",
      // Created 27 Oct 2026 (location hint APAC). `wrangler dev` still uses a local D1.
      "database_id": "ce6212af-73a8-4955-b271-a54da06d07ff",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "bikri-files" }, // till file API: only keys under products/ and shop/
    { "binding": "BACKUPS", "bucket_name": "bikri-backups" } // admin API only
  ],
  "vars": {
    "APP_VERSION": "0.1.0",
    "SCHEMA_VERSION": "1",
    "MIN_CLIENT_SCHEMA": "1",
    "MAINTENANCE": "0",
    "ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com", // TODO: set once Zero Trust is enabled on the account (team name not chosen yet)
    "BASE_PATH": "/bikri",
    "ALLOWED_ORIGINS": "https://algovyn.com",
    "SHOP_TIMEZONE": "Asia/Karachi"
  },
  "triggers": { "crons": ["30 21 * * *"] },
  "observability": { "enabled": true }
  // secrets (wrangler secret put): ACCESS_AUD, OWNER_EMAILS (= "operator@example.com")
}
