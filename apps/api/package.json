{
  "name": "@bikri/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "pnpm --filter @bikri/pos build && wrangler d1 migrations apply bikri --local && wrangler dev --port 8787 --local-upstream localhost:8787 --var ALLOWED_ORIGINS:http://localhost:8787",
    "test": "vitest run",
    "types": "wrangler types --include-runtime false",
    "db:migrate:local": "wrangler d1 migrations apply bikri --local"
  },
  "dependencies": {
    "@bikri/core": "workspace:*",
    "@bikri/db": "workspace:*",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "5.20261026.1",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  }
}
